const canonical = 'https://33navesa.ru/katalog/zabory/';
const faqJson = '{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Сколько стоит забор из поликарбоната под ключ?","acceptedAnswer":{"@type":"Answer","text":"Цена зависит от длины, высоты и каркаса: замерщик считает смету на месте, выезд по Москве и области — 0 ₽, цену фиксируем в договоре. Монтаж и бетонирование стоек уже включены."}},{"@type":"Question","name":"Сотовый или монолитный поликарбонат — что лучше для забора?","acceptedAnswer":{"@type":"Answer","text":"Сотовый легче и дешевле — ходовой вариант для дачи. Монолитный прочнее и выглядит как стекло, подходит для дома и улицы. Оба ставим на металлический каркас, служат от 15 лет."}},{"@type":"Question","name":"Прозрачный или закрытый забор выбрать?","acceptedAnswer":{"@type":"Answer","text":"Прозрачный пропускает свет и не затеняет участок — хорош между соседями и в саду. Закрытый (бронза, опал) скрывает двор от посторонних. Оба варианта делаем из поликарбоната 8–10 мм."}},{"@type":"Question","name":"Что лучше: сварной, кованый или комбинированный забор?","acceptedAnswer":{"@type":"Answer","text":"Сварной — самый доступный и быстрый. Кованый — дороже, но выглядит солиднее у дома. Комбинированный (профлист или штакетник + поликарбонат) — баланс цены и внешнего вида. Все три делаем под ключ."}},{"@type":"Question","name":"Подойдёт ли забор из поликарбоната для дачи и между соседями?","acceptedAnswer":{"@type":"Answer","text":"Да — для дачи это основной вариант: светлый, не затеняет грядки, ставится за 1–2 дня. Между соседями обычно берут прозрачный или сотовый высотой до 1,8 м."}},{"@type":"Question","name":"Делаете ли высокие заборы?","acceptedAnswer":{"@type":"Answer","text":"Да, делаем высокие заборы из поликарбоната на усиленном каркасе с бетонированием стоек — для дома и улицы, где нужно закрыться от дороги и посторонних."}},{"@type":"Question","name":"Сколько времени занимает монтаж забора под ключ?","acceptedAnswer":{"@type":"Answer","text":"Обычный участок — 1–2 дня: установка стоек, бетонирование, монтаж каркаса и листов. Точный срок называет замерщик после осмотра грунта и длины."}},{"@type":"Question","name":"Можно ли примкнуть навес к забору?","acceptedAnswer":{"@type":"Answer","text":"Да, делаем навесы из поликарбоната, примыкающие к забору: крыша на стойках крепится к каркасу забора. Удобно для парковки и хоздвора — считаем вместе с забором в одной смете."}}]}';
const ldJson = '{"@context":"https://schema.org","@graph":[{"@type":"CollectionPage","@id":"/katalog/zabory/","url":"/katalog/zabory/","name":"Заборы для дома купить с установкой под ключ цена работы за м2","isPartOf":{"@id":"/#website"},"primaryImageOfPage":{"@id":"/katalog/zabory/#primaryimage"},"image":{"@id":"/katalog/zabory/#primaryimage"},"thumbnailUrl":"/uploads/2021/05/svarnye-zabory-s-polikarbonatom.webp","description":"⭐⭐⭐⭐⭐ Компания Донгруп 33 навеса. Предлагаем купить заборы для дома с установкой под ключ по доступной цене работы за м2. Доставка и монтаж под ключ.","breadcrumb":{"@id":"/katalog/zabory/#breadcrumb"},"inLanguage":"ru-RU"},{"@type":"ImageObject","inLanguage":"ru-RU","@id":"/katalog/zabory/#primaryimage","url":"/uploads/2021/05/svarnye-zabory-s-polikarbonatom.webp","contentUrl":"/uploads/2021/05/svarnye-zabory-s-polikarbonatom.webp","width":800,"height":500},{"@type":"BreadcrumbList","@id":"/katalog/zabory/#breadcrumb","itemListElement":[{"@type":"ListItem","position":1,"name":"Каталог","item":"/katalog/"},{"@type":"ListItem","position":2,"name":"Заборы"}]},{"@type":"WebSite","@id":"/#website","url":"/","name":"Фабрика навесов","description":"","potentialAction":[{"@type":"SearchAction","target":{"@type":"EntryPoint","urlTemplate":"/?s={search_term_string}"},"query-input":{"@type":"PropertyValueSpecification","valueRequired":true,"valueName":"search_term_string"}}],"inLanguage":"ru-RU"}]}';

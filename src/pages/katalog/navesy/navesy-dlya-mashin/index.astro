const ldJson = '{"@context":"https://schema.org","@graph":[{"@type":"CollectionPage","@id":"/katalog/navesy/navesy-dlya-mashin/","url":"/katalog/navesy/navesy-dlya-mashin/","name":"Навесы для автомобилей и машин купить в Москве — цена с установкой под ключ","isPartOf":{"@id":"/#website"},"primaryImageOfPage":{"@id":"/katalog/navesy/navesy-dlya-mashin/#primaryimage"},"image":{"@id":"/katalog/navesy/navesy-dlya-mashin/#primaryimage"},"thumbnailUrl":"/uploads/2021/05/ukrytie-dlja-mashiny-iz-polikarbonata.webp","description":"⭐⭐⭐⭐⭐ Купить навес для авто, машины или автомобиля из поликарбоната под ключ в Москве и МО. От 163 200 ₽, монтаж за 1 день, гарантия 10 лет. Бесплатный замер.","breadcrumb":{"@id":"/katalog/navesy/navesy-dlya-mashin/#breadcrumb"},"inLanguage":"ru-RU"},{"@type":"ImageObject","inLanguage":"ru-RU","@id":"/katalog/navesy/navesy-dlya-mashin/#primaryimage","url":"/uploads/2021/05/ukrytie-dlja-mashiny-iz-polikarbonata.webp","contentUrl":"/uploads/2021/05/ukrytie-dlja-mashiny-iz-polikarbonata.webp","width":800,"height":500},{"@type":"BreadcrumbList","@id":"/katalog/navesy/navesy-dlya-mashin/#breadcrumb","itemListElement":[{"@type":"ListItem","position":1,"name":"Каталог","item":"/katalog/"},{"@type":"ListItem","position":2,"name":"Навесы","item":"/katalog/navesy/"},{"@type":"ListItem","position":3,"name":"Навесы для автомобилей"}]},{"@type":"WebSite","@id":"/#website","url":"/","name":"Фабрика навесов","description":"","potentialAction":[{"@type":"SearchAction","target":{"@type":"EntryPoint","urlTemplate":"/?s={search_term_string}"},"query-input":{"@type":"PropertyValueSpecification","valueRequired":true,"valueName":"search_term_string"}}],"inLanguage":"ru-RU"}]}';
const faqJson = '{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Какой навес выбрать для двух машин — какие размеры нужны?","acceptedAnswer":{"@type":"Answer","text":"Для двух авто берите 6×6 м (36 м²) — по 3 м на машину + запас для дверей. Односкатный 6×6 стоит от 244 800 ₽ под ключ (от 6800 ₽/м², монтаж уже включён). Каркас: стойки 100×100, ферма 40×25, поликарбонат 8 мм на термошайбы, бетонирование 0,8 м. Гарантия 10 лет, доставка до 50 км от МКАД бесплатно."}},{"@type":"Question","name":"Чем навес из поликарбоната отличается от навеса из профнастила для машины?","acceptedAnswer":{"@type":"Answer","text":"Поликарбонат пропускает свет, не нагревается как металл, защищает от града и выглядит легче. Профнастил глухой и темнее, дешевле на 10–15%. Каркас одинаковый (стойки 100×100, ферма 40×25), но поликарбонат крепим на термошайбы — без протечек и служит дольше. Для двора рекомендуем поликарбонат 8 мм."}},{"@type":"Question","name":"Какой материал каркаса лучше — металл или металл с поликарбонатом?","acceptedAnswer":{"@type":"Answer","text":"Каркас всегда металлический (стойки 100×100, лаги 80×80). Разница в обшивке: чистый металл дешевле, но темнее и шумнее в дождь; металл + поликарбонат светлее, не ржавеет под крепежом и лучше сбрасывает снег. Оба варианта делаем под ключ от 5 дней."}},{"@type":"Question","name":"Делаете ли навесы для машин на даче?","acceptedAnswer":{"@type":"Answer","text":"Да — дачные 3×6 м (18 м², от 122 400 ₽) и 4×6 м (24 м², от 163 200 ₽). Выезд замерщика по МО, доставка до 50 км от МКАД бесплатно. Монтаж 1–2 дня, работаем ежедневно с 9:00 до 18:00, договор и смета на месте."}},{"@type":"Question","name":"Односкатный или двухскатный навес лучше для автомобиля?","acceptedAnswer":{"@type":"Answer","text":"Односкатный дешевле и быстрее в монтаже (от 6800 ₽/м²), подходит для двора и дачи, проще в чистке снега. Двухскатный прочнее на снеговой нагрузке и симметрично смотрится у дома, но дороже на 15–20%. Оба делаем на том же профиле, гарантия 10 лет."}},{"@type":"Question","name":"Уличный навес для машины — чем отличается от обычного?","acceptedAnswer":{"@type":"Answer","text":"Конструктивно ничем — тот же навес, но с усиленным бетонированием 0,8 м и ветровой устойчивостью. Так называют навесы во дворе без привязки к дому. Стандарт: 3×6 на одно авто, 6×6 на два, цена от 6800 ₽/м² под ключ."}},{"@type":"Question","name":"Навес под машину vs над машиной — есть разница?","acceptedAnswer":{"@type":"Answer","text":"Нет, синонимы — запросы под-машину и над-машиной ведут на один тип. Делаем 3×6 м на одно авто (от 122 400 ₽) и 6×6 м на два (от 244 800 ₽). Цена от площади, монтаж включён, замер бесплатный при договоре."}},{"@type":"Question","name":"Есть ли недорогие автомобильные навесы?","acceptedAnswer":{"@type":"Answer","text":"Да, эконом — профиль 40×25 и поликарбонат 6 мм от 6800 ₽/м² под ключ. Для наших снегов рекомендуем 8 мм (доплата ~400 ₽/м²) — выдерживает больше и не продавливается. Изготовление от 5 дней, доставка бесплатно до 50 км от МКАД."}},{"@type":"Question","name":"Навес для авто из поликарбоната с установкой под ключ — что входит?","acceptedAnswer":{"@type":"Answer","text":"Выезд замерщика, изготовление каркаса, доставка, бетонирование стоек 0,8 м, обшивка поликарбонатом 8 мм на термошайбы, уборка площадки. Работа по договору, смета фиксируется на замере, предоплата 50%, гарантия 10 лет на каркас и монтаж."}},{"@type":"Question","name":"Делаете ли арочные и плоские (с прямой крышей) навесы?","acceptedAnswer":{"@type":"Answer","text":"Да. Арочные красивее и лучше сбрасывают снег, подходят для двора. Плоские (односкатные с прямым скатом) проще и дешевле, удобны для примыкания к дому. Оба делаем из профиля 40×25, стойки 100×100, поликарбонат 8 мм."}}]}';

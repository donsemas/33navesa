---
import Header from "../../../../components/Header.astro";
import Footer from "../../../../components/Footer.astro";
import "../../../../styles/base.css";

export async function getStaticPaths({ paginate }) {
  // Данные для пагинации категории "Навесы" — берём из реального каталога
  // В оригинальном WP было 9+ элементов, пагинация /page/2/ существовала
  const allItems = [
    { title: "Автомобильные навесы", href: "/katalog/navesy/avtomobilnye-navesy/", img: "/uploads/2021/05/navesy-dlya-mashiny-odnoskatnye.webp", price: "5400" },
    { title: "Металлические навесы", href: "/katalog/navesy/metallicheskie-navesy/", img: "/uploads/2021/05/metallicheskie-navesy.webp", price: "5400" },
    { title: "Односкатные навесы", href: "/katalog/navesy/odnoskatnye-navesy/", img: "/uploads/2021/05/odnoskatnye-navesy-iz-polikarbonata.webp", price: "5400" },
    { title: "Двухскатные навесы", href: "/katalog/navesy/dvuhskatnye-navesy/", img: "/uploads/2021/05/navesy-dvuhskatnye-iz-profnastila.webp", price: "5400" },
    { title: "Арочные навесы", href: "/katalog/navesy/arochnye-navesy/", img: "/uploads/2021/05/arochnye-navesy-iz-polikarbonata.webp", price: "5400" },
    { title: "Навесы из поликарбоната", href: "/katalog/navesy/navesy-iz-polikarbonata/", img: "/uploads/2021/05/navesy-iz-polikarbonata.webp", price: "5400" },
    { title: "Крытые навесы", href: "/katalog/navesy/krytye-navesy/", img: "/uploads/2021/05/krytye-navesy-iz-polikarbonata.webp", price: "5400" },
    { title: "Навесы для автомобилей", href: "/katalog/navesy/navesy-dlya-mashin/", img: "/uploads/2021/05/navesy-dlya-mashiny.webp", price: "5400" },
    { title: "Садовые навесы", href: "/katalog/navesy/sadovye-navesy/", img: "/uploads/2021/05/sadovye-navesy-dlja-dachi.webp", price: "5400" },
    { title: "Навесы для барбекю", href: "/katalog/navesy/navesy-dlya-barbekju/", img: "/uploads/2021/05/navesy-dlja-barbekju-iz-polikarbonata.webp", price: "5400" },
    { title: "Навесы для бассейна", href: "/katalog/navesy/navesy-dlya-bassejna/", img: "/uploads/2021/05/navesy-dlya-bassejna-iz-polikarbonata.webp", price: "5400" },
    { title: "Навесы для мангала", href: "/katalog/navesy/navesy-dlya-mangala/", img: "/uploads/2021/05/navesy-dlya-mangala-iz-polikarbonata.webp", price: "5400" },
    { title: "Навесы для дачи", href: "/katalog/navesy/navesy-dlya-dachi/", img: "/uploads/2021/05/navesy-dlya-dachi-iz-polikarbonata.webp", price: "5400" },
    { title: "Навесы для террасы", href: "/katalog/navesy/navesy-dlya-terrasy/", img: "/uploads/2021/05/navesy-dlya-terrasy-iz-polikarbonata.webp", price: "5400" },
    { title: "Навесы для крыльца", href: "/katalog/navesy/navesy-dlya-krylca/", img: "/uploads/2021/05/navesy-dlya-krylca-iz-polikarbonata.webp", price: "5400" },
    { title: "Навесы для балкона", href: "/katalog/navesy/navesy-dlya-balkona/", img: "/uploads/2021/05/navesy-dlya-balkona-iz-polikarbonata.webp", price: "5400" },
    { title: "Другие навесы", href: "/katalog/navesy/drugie/", img: "/uploads/2021/05/navesy.webp", price: "5400" },
    { title: "Навесы для гаража", href: "/katalog/garazhi-iz-polikarbonata/", img: "/uploads/2021/05/navesy-dlya-garazha.webp", price: "5400" },
  ];
  // pageSize 9 -> будет 2 страницы: /katalog/navesy/page/1/ и /katalog/navesy/page/2/
  return paginate(allItems, { pageSize: 9 });
}

const { page } = Astro.props;
const title = `Навесы — каталог, страница ${page.currentPage}`;
const description = `Каталог навесов из поликарбоната — страница ${page.currentPage}. Производство и монтаж навесов по доступной цене.`;
const canonical = page.currentPage === 1 ? "/katalog/navesy/" : `/katalog/navesy/page/${page.currentPage}/`;
---

<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
  <link rel="shortcut icon" href="/favicon.gif" type="image/gif" />
  <title>{title}</title>
  {description && <meta name="description" content={description} />}
  <link rel="canonical" href={canonical} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <link rel="stylesheet" href="/wp-content/themes/naves/css/main.css" />
  <link rel="stylesheet" href="/wp-content/themes/naves/style.css" />
  <link rel="stylesheet" href="/wp-content/themes/naves/css/media.css" />
</head>
<body>
  <Header />
  <div class="content">
    <div class="container">
      <div class="breadcrumbs">
        <a href="/">Главная</a> &gt; <a href="/katalog/">Каталог</a> &gt; <span>Навесы — страница {page.currentPage}</span>
      </div>
      <h1>Навесы — страница {page.currentPage} из {page.lastPage}</h1>
      <div class="catalog-list">
        <div class="row">
          {page.data.map((item) => (
            <div class="box">
              <a href={item.href}>
                <div class="catalog-list__item">
                  <div class="catalog-list__item-image">
                    <img src={item.img} alt={item.title} loading="lazy" width="400" height="250" />
                  </div>
                  <div class="catalog-list__item-title">{item.title}</div>
                </div>
              </a>
              <div class="catalog-list__item-price"><span>Цена от {item.price} ₽/м²</span></div>
            </div>
          ))}
        </div>
      </div>

      <nav class="navigation pagination" aria-label="Пагинация">
        <div class="nav-links">
          {page.url.prev && <a class="prev page-numbers" href={page.url.prev}>Назад</a>}
          {Array.from({ length: page.lastPage }, (_, i) => {
            const n = i + 1;
            const href = n === 1 ? "/katalog/navesy/" : `/katalog/navesy/page/${n}/`;
            const isCurrent = n === page.currentPage;
            return isCurrent ? <span aria-current="page" class="page-numbers current">{n}</span> : <a class="page-numbers" href={href}>{n}</a>;
          })}
          {page.url.next && <a class="next page-numbers" href={page.url.next}>Далее</a>}
        </div>
      </nav>
    </div>
  </div>
  <Footer />
  <script is:inline src="/wp-content/themes/naves/js/script.js"></script>
  <script is:inline src="/wp-content/themes/naves/js/main.js"></script>
</body>
</html>

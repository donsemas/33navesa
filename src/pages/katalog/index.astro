const canonical = '/katalog/';
const ldJson = '{"@context":"https://schema.org","@graph":[{"@type":"CollectionPage","@id":"/katalog/","url":"/katalog/","name":"Каталог изделий из поликарбоната цена под ключ","isPartOf":{"@id":"/#website"},"primaryImageOfPage":{"@id":"/katalog/#primaryimage"},"image":{"@id":"/katalog/#primaryimage"},"thumbnailUrl":"/uploads/2021/05/naves_iz_polikarbonata_v_g._odincovo.webp","description":"Компания Донгруп 33 навеса. Предлагаем каталог изделий из поликарбоната по выгодной. Телефон ☎: +7(495) 128-23-27. Выгодные условия сотрудничества. Режим работы: Пн-Пт с 09:00 до 18:00.","inLanguage":"ru-RU"},{"@type":"ImageObject","inLanguage":"ru-RU","@id":"/katalog/#primaryimage","url":"/uploads/2021/05/naves_iz_polikarbonata_v_g._odincovo.webp","contentUrl":"/uploads/2021/05/naves_iz_polikarbonata_v_g._odincovo.webp","width":800,"height":500},{"@type":"WebSite","@id":"/#website","url":"/","name":"Фабрика навесов","description":"","potentialAction":[{"@type":"SearchAction","target":{"@type":"EntryPoint","urlTemplate":"/?s={search_term_string}"},"query-input":{"@type":"PropertyValueSpecification","valueRequired":true,"valueName":"search_term_string"}}],"inLanguage":"ru-RU"}]}';

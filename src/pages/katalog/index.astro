---
import Header from "../../components/Header.astro"
import Sidebar from "../../components/Sidebar.astro";;
import Footer from "../../components/Footer.astro";
import "../../styles/base.css";
const title = 'Каталог изделий из поликарбоната цена под ключ';
const description = 'Компания Донгруп 33 навеса. Предлагаем каталог изделий из поликарбоната по выгодной. Выгодные условия сотрудничества. Гарантия 10 лет. Установка за 1 день.';
const canonical = 'https://33navesa.ru/katalog/';
const ldJson = '{"@context":"https://schema.org","@graph":[{"@type":"CollectionPage","@id":"/katalog/","url":"/katalog/","name":"Каталог изделий из поликарбоната цена под ключ","isPartOf":{"@id":"/#website"},"primaryImageOfPage":{"@id":"/katalog/#primaryimage"},"image":{"@id":"/katalog/#primaryimage"},"thumbnailUrl":"/uploads/2021/05/naves_iz_polikarbonata_v_g._odincovo.webp","description":"Компания Донгруп 33 навеса. Предлагаем каталог изделий из поликарбоната по выгодной. Выгодные условия сотрудничества. Гарантия 10 лет. Установка за 1 день.","inLanguage":"ru-RU"},{"@type":"ImageObject","inLanguage":"ru-RU","@id":"/katalog/#primaryimage","url":"/uploads/2021/05/naves_iz_polikarbonata_v_g._odincovo.webp","contentUrl":"/uploads/2021/05/naves_iz_polikarbonata_v_g._odincovo.webp","width":800,"height":500},{"@type":"WebSite","@id":"/#website","url":"/","name":"Фабрика навесов","description":"","potentialAction":[{"@type":"SearchAction","target":{"@type":"EntryPoint","urlTemplate":"/?s={search_term_string}"},"query-input":{"@type":"PropertyValueSpecification","valueRequired":true,"valueName":"search_term_string"}}],"inLanguage":"ru-RU"}]}';
---

<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
  <link rel="shortcut icon" href="/favicon.gif" type="image/gif" />
  <link rel="icon" href="/favicon.gif" type="image/gif" />
  <title>{title}</title>
  {description && <meta name="description" content={description} />}
  <link rel="canonical" href={canonical} />
  <meta property="og:locale" content="ru_RU">
    <meta property="og:type" content="article">
    <meta property="og:title" content="Каталог изделий из поликарбоната цена под ключ">
    <meta property="og:description" content="Компания Донгруп 33 навеса. Предлагаем каталог изделий из поликарбоната по выгодной. Выгодные условия сотрудничества. Гарантия 10 лет. Установка за 1 день.">
    <meta property="og:image" content="https://33navesa.ru/uploads/2021/05/naves_iz_polikarbonata_v_g._odincovo.webp" />
<meta property="og:image:width" content="800" />
    <meta property="og:image:height" content="500" />
    <meta property="og:image:type" content="image/webp" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://33navesa.ru/uploads/2021/05/naves_iz_polikarbonata_v_g._odincovo.webp" />
    <meta property="og:url" content="https://33navesa.ru/katalog/">
    <meta property="og:site_name" content="Фабрика навесов">
  <link rel="stylesheet" href="/wp-content/themes/naves/css/main.css" />
  <link rel="stylesheet" href="/wp-content/themes/naves/style.css" />
  <link rel="stylesheet" href="/wp-content/themes/naves/css/media.css" />
  {ldJson && <script is:inline type="application/ld+json" set:html={ldJson} />}
</head>
<body>
  <Header />
  <div class="content">
    <div class="container">
        <div class="row">
            <Sidebar currentCategory="dom" />
            <main set:html={`

                <div class="breadcrumbs" typeof="BreadcrumbList" vocab="http://schema.org/">
	<span property="itemListElement" typeof="ListItem"><a property="item" typeof="WebPage" title="Перейти к Фабрика навесов." href="/" class="home"><span property="name">Главная</span></a><meta property="position" content="1"></span> &gt; <span property="itemListElement" typeof="ListItem"><span property="name" class="archive taxonomy category current-item">Каталог</span><meta property="url" content="/katalog/"><meta property="position" content="2"></span></div>                

                <h1>Каталог</h1>
                
                                    
                    <div class="catalog-list">
    
                        <div class="row">

                            
                            <div class="box">
                                <a href="/katalog/besedki/"> 
                                    <div class="catalog-list__item">            
                                        <div class="catalog-list__item-image">
                                            <img loading="lazy" decoding="async" src="/uploads/2021/05/Besedki.webp" alt="Беседки">
                                        </div>
                                        <div class="catalog-list__item-title">
                                            Беседки                                        </div>                    
                                    </div>
                                </a> 
                            </div>

                            
                            <div class="box">
                                <a href="/katalog/garazhi-iz-polikarbonata/"> 
                                    <div class="catalog-list__item">            
                                        <div class="catalog-list__item-image">
                                            <img loading="lazy" decoding="async" src="/uploads/2021/05/garazhi-navesy-dlja-mashin.webp" alt="Гаражи">
                                        </div>
                                        <div class="catalog-list__item-title">
                                            Гаражи                                        </div>                    
                                    </div>
                                </a> 
                            </div>

                            
                            <div class="box">
                                <a href="/katalog/zabory/"> 
                                    <div class="catalog-list__item">            
                                        <div class="catalog-list__item-image">
                                            <img loading="lazy" decoding="async" src="/uploads/2022/05/zabory-iz-polikarbonata-mezhdu-sosedjami.webp" alt="Заборы">
                                        </div>
                                        <div class="catalog-list__item-title">
                                            Заборы                                        </div>                    
                                    </div>
                                </a> 
                            </div>

                            
                            <div class="box">
                                <a href="/katalog/navesy/"> 
                                    <div class="catalog-list__item">            
                                        <div class="catalog-list__item-image">
                                            <img loading="lazy" decoding="async" src="/uploads/2021/05/navesy.webp" alt="Навесы">
                                        </div>
                                        <div class="catalog-list__item-title">
                                            Навесы                                        </div>                    
                                    </div>
                                </a> 
                            </div>

                            
                        </div>

                    </div>

                                    <div class="cat__text">
                    <p>Описание</p>
                </div>
            </main>


        </div>
    </div>
</div>`} />
  <Footer />
</body>
</html>

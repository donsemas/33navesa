const faqJson = '{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Сколько стоит беседка из поликарбоната под ключ?","acceptedAnswer":{"@type":"Answer","text":"От 6800 ₽/м² под ключ, монтаж уже включён. Беседка 3×3 м — от 61 200 ₽. Каркас из профильной трубы, поликарбонат 8 мм, бетонирование стоек. Точную смету назовёт замерщик: выезд по Москве и области 0 ₽, цену фиксируем в договоре."}},{"@type":"Question","name":"Чем беседка из поликарбоната отличается от металлической?","acceptedAnswer":{"@type":"Answer","text":"Каркас всегда металлический. Разница в обшивке: поликарбонат светлый и защищает от дождя, металл глухой. Комбинируем: крыша из поликарбоната, боковины из металла или открытые. Оба варианта делаем под ключ от 7 дней, гарантия 10 лет."}},{"@type":"Question","name":"Какая беседка лучше для дачи — открытая или закрытая?","acceptedAnswer":{"@type":"Answer","text":"Открытая дешевле и подходит для лета: крыша из поликарбоната, без стен. Закрытая (застеклённая) — для круглогодичного использования, дороже на 30–40%. Дачные чаще берут открытые 3×3 м."}},{"@type":"Question","name":"Делаете ли садовые беседки?","acceptedAnswer":{"@type":"Answer","text":"Да — садовые беседки из поликарбоната и металла для участка: над зоной отдыха, у пруда, рядом с мангалом. Лёгкие модели вписываются в сад, поликарбонат не затеняет растения."}},{"@type":"Question","name":"Беседка-навес — что это и чем отличается?","acceptedAnswer":{"@type":"Answer","text":"Беседка-навес — упрощённая конструкция: крыша из поликарбоната на стойках без стен. Дешевле классической беседки, ставится за 1–2 дня. Подходит для дачи и двора как укрытие от дождя и солнца."}},{"@type":"Question","name":"Какая крыша лучше для беседки — поликарбонат или металл?","acceptedAnswer":{"@type":"Answer","text":"Поликарбонат 8–10 мм — светлее и тише в дождь. Металл (профнастил, металлочерепица) — глухой и дешевле. Крышу подбираем в цвет дома, оба варианта на том же каркасе."}},{"@type":"Question","name":"Делаете ли беседки 3×3 м?","acceptedAnswer":{"@type":"Answer","text":"Да, 3×3 м — самый ходовой размер для дачи: стол на 6–8 человек помещается свободно. От 61 200 ₽ под ключ, монтаж 1–2 дня."}},{"@type":"Question","name":"Выезжаете ли в Москву и область на замер беседки?","acceptedAnswer":{"@type":"Answer","text":"Да, замер по Москве и МО бесплатный при договоре. Доставка до 50 км от МКАД бесплатно, монтаж 1–2 дня, работаем ежедневно с 9:00 до 18:00."}}]}';
const ldJson = '{"@context":"https://schema.org","@graph":[{"@type":"CollectionPage","@id":"/katalog/besedki/","url":"/category/besedki/besedki-iz-polikarbonata/","name":"Беседки для дачи купить цена от производителя под ключ с доставкой","isPartOf":{"@id":"/#website"},"primaryImageOfPage":{"@id":"/category/besedki/besedki-iz-polikarbonata/#primaryimage"},"image":{"@id":"/category/besedki/besedki-iz-polikarbonata/#primaryimage"},"thumbnailUrl":"/uploads/2021/05/sadovye-besedki-dlja-dachi-iz-polikarbonata.webp","description":"⭐⭐⭐⭐⭐ Компания Донгруп 33 навеса. Предлагаем купить беседки для дачи под ключ по цене от производителя с доставкой. 100% качественные материалы.","breadcrumb":{"@id":"/category/besedki/besedki-iz-polikarbonata/#breadcrumb"},"inLanguage":"ru-RU"},{"@type":"ImageObject","inLanguage":"ru-RU","@id":"/category/besedki/besedki-iz-polikarbonata/#primaryimage","url":"/uploads/2021/05/sadovye-besedki-dlja-dachi-iz-polikarbonata.webp","contentUrl":"/uploads/2021/05/sadovye-besedki-dlja-dachi-iz-polikarbonata.webp","width":800,"height":500},{"@type":"BreadcrumbList","@id":"/category/besedki/besedki-iz-polikarbonata/#breadcrumb","itemListElement":[{"@type":"ListItem","position":1,"name":"Каталог","item":"/katalog/"},{"@type":"ListItem","position":2,"name":"Беседки"}]},{"@type":"WebSite","@id":"/#website","url":"/","name":"Фабрика навесов","description":"","potentialAction":[{"@type":"SearchAction","target":{"@type":"EntryPoint","urlTemplate":"/?s={search_term_string}"},"query-input":{"@type":"PropertyValueSpecification","valueRequired":true,"valueName":"search_term_string"}}],"inLanguage":"ru-RU"}]}';

---
import Header from "../../components/Header.astro"
import Sidebar from "../../components/Sidebar.astro";;
import Footer from "../../components/Footer.astro";
import "../../styles/base.css";
const title = 'Контакты организации по производству навесов в Москве и Московской области';
const description = 'Компания Донгруп 33 навеса. Предлагаем контакты организации по производству навесов в Москве и Московской области. Адрес: г. Москва, ул.Западная, 9Б.';
const canonical = 'https://33navesa.ru/kontakty/';
const ldJson = '{"@context":"https://schema.org","@graph":[{"@type":"WebPage","@id":"/kontakty/","url":"/kontakty/","name":"Контакты организации по производству навесов в Москве и Московской области","isPartOf":{"@id":"/#website"},"datePublished":"2021-05-10T08:10:10+00:00","dateModified":"2026-09-05T12:00:00+00:00","description":"Компания Донгруп 33 навеса. Предлагаем контакты организации по производству навесов в Москве и Московской области. Адрес: г. Москва, ул.Западная, 9Б.","inLanguage":"ru-RU","potentialAction":[{"@type":"ReadAction","target":["/kontakty/"]}]},{"@type":"WebSite","@id":"/#website","url":"/","name":"Фабрика навесов","description":"","potentialAction":[{"@type":"SearchAction","target":{"@type":"EntryPoint","urlTemplate":"/?s={search_term_string}"},"query-input":{"@type":"PropertyValueSpecification","valueRequired":true,"valueName":"search_term_string"}}],"inLanguage":"ru-RU"}]}';
---

<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
  <link rel="shortcut icon" href="/favicon.gif" type="image/gif" />
  <link rel="icon" href="/favicon.gif" type="image/gif" />
  <title>{title}</title>
  {description && <meta name="description" content={description} />}
  <link rel="canonical" href={canonical} />
  <meta property="og:locale" content="ru_RU">
    <meta property="og:type" content="article">
    <meta property="og:title" content="Контакты организации по производству навесов в Москве и Московской области">
    <meta property="og:description" content="Компания Донгруп 33 навеса. Предлагаем контакты организации по производству навесов в Москве и Московской области. Адрес: г. Москва, ул.Западная, 9Б.">
    <meta property="og:image" content="https://33navesa.ru/uploads/2021/05/Logo.webp" />
    <meta property="og:image:type" content="image/webp" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://33navesa.ru/uploads/2021/05/Logo.webp" />
    <meta property="og:url" content="https://33navesa.ru/kontakty/">
    <meta property="og:site_name" content="Фабрика навесов">
  <link rel="stylesheet" href="/wp-content/themes/naves/css/main.css" />
  <link rel="stylesheet" href="/wp-content/themes/naves/style.css" />
  <link rel="stylesheet" href="/wp-content/themes/naves/css/media.css" />
  {ldJson && <script is:inline type="application/ld+json" set:html={ldJson} />}
</head>
<body>
  <Header />
  <div class="content">
    <div class="container">
        <div class="row">
            <Sidebar />
            <main set:html={`

                <div class="breadcrumbs" typeof="BreadcrumbList" vocab="http://schema.org/">
	<span property="itemListElement" typeof="ListItem"><a property="item" typeof="WebPage" title="Перейти к Фабрика навесов." href="/" class="home"><span property="name">Главная</span></a><meta property="position" content="1"></span> &gt; <span property="itemListElement" typeof="ListItem"><span property="name" class="post post-page current-item">Контакты</span><meta property="url" content="/kontakty/"><meta property="position" content="2"></span></div> 
                <h1>Контакты</h1>
                <div class="contact-form">
                    <h3>Подать заявку:</h3>
                
                    <form action="" id="contacts-form" class="form contacts-form" method="post" enctype="multipart/form-data">
                        <input type="hidden" name="subject" value="Форма в контактах">
						<input type="text" name="name" value="" style="position: absolute; left: -9999px; display: none;">
                        <div class="form-group">
                            <input type="text" class="form__field" name="fio" placeholder="Ваше имя" required>
                        </div>
                        <div class="form-group">
                            <input type="tel" name="phone" placeholder="Телефон" class="form__field" required>
                        </div>
                        <div class="form-group">
                            <textarea name="comment" placeholder="Введите текст" class="form__field"></textarea>
                        </div>

                        <div class="form-group files">
                            <div class="files__left">
                                Разрешенные типы файлов: docx, xlsx, jpg, bmp, png, pdf, rar, zip
                            </div>	
                            <div class="files__right">
                                <label for="myfile" class="form__file">
                                <span class="count">Прикрепить файлы</span>
                            </label>
                            <input type="file" name="file[]" id="myfile" multiple class="form__field-file">
                            </div>
                        
                        </div>
                        
                        <div class="form-group form-check">
                            <label class="form-check-label">
                                <input name="checkpolit" type="checkbox" checked class="form-check-input" required>
                                <span>Согласен с <a href="#" target="_blank">политикой конфиденциальности</a></span>
                            </label>
                        </div>
                        <div class="form-group form-submit">
                            <input type="submit" class="btn" name="submit" value="Отправить">
                        </div>
                    </form>

                </div>
                
                <h3>Контакты</h3>

                <a href="tel:+79051492388" class="cont__phone-num">+7(905) 149-23-88</a>
                  
               
                <h3>Наше производство</h3>
<p>г. Москва, ул.Западная 9Б, Восточный административный округ</p>
<p><iframe loading="lazy" src="https://yandex.ru/map-widget/v1/?um=constructor%3A539b7099117ef42468e44aef7c44f35c5b5ea005c47404eaa68091cc7dd0f58b&amp;source=constructor" width="100%" height="400" frameborder="0"></iframe></p>
<p>Мы осуществляем бесплатную доставку в пределах 50 км от МКАД. Установка производится по<br>
договоренности, как нашими силами так и силами клиента.</p>
<p>При заказе навеса из поликарбоната по индивидуальному проекту(заказу), Вы можете уточнить<br>
стоимость заказа с точностью 90%. Окончательная стоимость согласовывается после выезда<br>
замерщика</p>

                


            </main>


        </div>
    </div>
</div>`} />
  <Footer />
</body>
</html>

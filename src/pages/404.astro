---
import Header from "../components/Header.astro"
import Sidebar from "../components/Sidebar.astro";;
import Footer from "../components/Footer.astro";
import "../styles/base.css";
const title = 'Страница не найдена — 33Навеса';
const description = 'Такой страницы нет. Зато есть навесы из поликарбоната под ключ — вернитесь на главную.';
const canonical = 'https://33navesa.ru/404.html';
---

<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="icon" href="/favicon-120.png" sizes="120x120" type="image/png" />
  <link rel="shortcut icon" href="/favicon.gif" type="image/gif" />
  <link rel="icon" href="/favicon.gif" type="image/gif" />
  <title>{title}</title>
  {description && <meta name="description" content={description} />}
  <meta name="robots" content="noindex, follow" />
  <link rel="stylesheet" href="/wp-content/themes/naves/css/main.css" />
  <link rel="stylesheet" href="/wp-content/themes/naves/style.css" />
  <link rel="stylesheet" href="/wp-content/themes/naves/css/media.css" />
<style>
.err404{background:#141414;color:#fff;border-radius:14px;overflow:hidden;margin:24px 0;}
.err404-top{background:linear-gradient(180deg,#1e1e1e 0%,#141414 100%);border-bottom:4px solid #f26522;padding:48px 32px 36px;text-align:center;position:relative;}
.err404-top::before{content:'';position:absolute;inset:0;background:repeating-linear-gradient(-45deg,transparent 0 14px,rgba(255,255,255,.025) 14px 16px);pointer-events:none;}
.err404-code{font-size:clamp(90px,18vw,190px);font-weight:900;line-height:1;margin:0;letter-spacing:4px;background:linear-gradient(180deg,#3a3a3a 0%,#8a8a8a 45%,#d7d7d7 50%,#8a8a8a 55%,#3a3a3a 100%);-webkit-background-clip:text;background-clip:text;color:transparent;}
.err404-code span{color:#f26522;-webkit-text-fill-color:#f26522;}
.err404 h1{font-size:clamp(22px,3.4vw,34px);margin:12px 0 8px;color:#fff;text-transform:uppercase;}
.err404-sub{color:#bdbdbd;font-size:17px;margin:0 auto 26px;max-width:560px;}
.err404-btn{display:inline-block;background:#f26522;color:#fff;font-weight:800;font-size:20px;padding:18px 64px;border-radius:12px;text-decoration:none;text-transform:uppercase;box-shadow:0 10px 30px rgba(242,101,34,.35);transition:transform .15s ease,box-shadow .15s ease;}
.err404-btn:hover{background:#ff7a3d;color:#fff;transform:translateY(-2px);box-shadow:0 14px 34px rgba(242,101,34,.45);}
.err404-links{margin-top:22px;display:flex;flex-wrap:wrap;gap:10px 22px;justify-content:center;}
.err404-links a{color:#f26522;font-size:15px;}
.err404-photos{display:grid;grid-template-columns:repeat(3,1fr);gap:0;}
.err404-photos img{width:100%;height:180px;object-fit:cover;display:block;filter:grayscale(35%) contrast(1.05);}
@media (max-width:640px){.err404-photos img{height:110px;}.err404-top{padding:36px 18px 28px;}.err404-btn{padding:16px 40px;font-size:17px;}}
</style>
</head>
<body>
  <Header />
  <div class="content">
    <div class="container">
        <div class="row">
            <Sidebar />
            <main>
                <div class="breadcrumbs"><a href="/">Главная</a> &gt; <span>Страница не найдена</span></div>
                <div class="err404">
                    <div class="err404-top">
                        <div class="err404-code">4<span>0</span>4</div>
                        <h1>Такой страницы нет</h1>
                        <p class="err404-sub">Возможно, адрес устарел или в нём опечатка. Зато навесы из поликарбоната под ключ — на месте: замер бесплатно, монтаж за 1–2 дня.</p>
                        <a class="err404-btn" href="/">На главную</a>
                        <div class="err404-links">
                            <a href="/katalog/navesy/navesy-dlya-mashin/">Для авто</a>
                            <a href="/katalog/navesy/navesy-dlya-dachi/">Для дачи</a>
                            <a href="/katalog/besedki/">Беседки</a>
                            <a href="/katalog/zabory/">Заборы</a>
                            <a href="/cena/">Цены</a>
                        </div>
                    </div>
                    <div class="err404-photos">
                        <img loading="lazy" decoding="async" src="/uploads/2021/05/svarnye-zabory-s-polikarbonatom.webp" alt="Металлический каркас">
                        <img loading="lazy" decoding="async" src="/uploads/2021/05/kovanye-zabory-s-polikarbonatom.webp" alt="Навес из поликарбоната">
                        <img loading="lazy" decoding="async" src="/uploads/2021/05/montazh-zabora-polikarbonata.webp" alt="Монтаж конструкции">
                    </div>
                </div>
            </main>
        </div>
    </div>
</div>
  <Footer />
</body>
</html>

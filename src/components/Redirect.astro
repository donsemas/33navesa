---
// Статическая страница-редирект (запасной путь, пока edge-правила не исполняются
// на кастомном домене). Мгновенный meta-refresh + canonical + JS.
interface Props {
  target: string;
  title?: string;
}
const { target, title = "Страница переехала" } = Astro.props;
---
<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="robots" content="noindex, follow" />
  <link rel="canonical" href={target} />
  <meta http-equiv="refresh" content={`0;url=${target}`} />
  <script is:inline define:vars={{ target }}>
    window.location.replace(target);
  </script>
</head>
<body>
  <p>Страница переехала: <a href={target}>перейти</a></p>
</body>
</html>

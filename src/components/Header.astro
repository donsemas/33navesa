<script is:inline>
document.addEventListener('DOMContentLoaded', function () {
  var bt = document.querySelector('.nav-mob__bt');
  var box = document.querySelector('.mob-box');
  if (bt && box) bt.addEventListener('click', function () {
    var opened = box.classList.toggle('visible');
    bt.classList.toggle('open', opened);
    document.body.classList.toggle('menu-open', opened);
  });
  var catHead = document.querySelector('.mob-catalog__head');
  if (catHead) catHead.addEventListener('click', function () {
    catHead.parentElement.classList.toggle('open');
  });
});
</script>

---
// Sidebar.astro — фиксированный конверсионный сайдбар для услуг и каталога.
// Пропсы:
//   currentCategory?: "avto" | "dom" | "bassein" | "zabory" — подсветка активного раздела
//   showCalculator?: boolean — показать/скрыть блок калькулятора (по умолчанию true)
export interface Props {
  currentCategory?: string;
  showCalculator?: boolean;
}
const { currentCategory = "", showCalculator = true } = Astro.props;
const cats = [
  { id: "avto", label: "Навесы для авто", href: "/katalog/navesy/navesy-dlya-mashin/", svg: '<path d="M5 16l1-5h12l1 5M7 16h10M7 19v1M17 19v1"/>' },
  { id: "dom", label: "Навесы для дома и террасы", href: "/katalog/navesy/navesy-dlya-dachi/", svg: '<path d="M4 11l8-6 8 6M6 10v9h12v-9"/>' },
  { id: "bassein", label: "Навесы для бассейнов", href: "/katalog/navesy/navesy-dlya-bassejna/", svg: '<path d="M4 16c2 0 2 2 4 2s2-2 4-2 2 2 4 2 2-2 4-2M6 12V6h12v6"/>' },
  { id: "zabory", label: "Металлоконструкции и заборы", href: "/katalog/zabory/", svg: '<path d="M5 5v14M10 5v14M15 5v14M20 5v14M3 8h18"/>' },
];
---
<aside class="sitebar conv-sidebar">
<div class="conv-fixed">
  {showCalculator && (
    <div class="conv-card" data-conv-calc>
      <div class="conv-title">Быстрый расчет</div>
      <label class="conv-label">Тип конструкции
        <select data-type>
          <option>Навес для авто</option>
          <option>Навес к дому</option>
          <option>Беседка</option>
          <option>Навес</option>
          <option>Забор</option>
        </select>
      </label>
      <div class="conv-row">
        <label class="conv-label">Длина (м)<input type="number" min="1" max="100" step="0.5" value="6" data-len /></label>
        <label class="conv-label">Ширина (м)<input type="number" min="1" max="100" step="0.5" value="4" data-wid /></label>
      </div>
      <div class="conv-result" data-out>от 163 200 ₽</div>
    </div>
  )}
  <div class="conv-card" data-conv-measure>
    <div class="conv-title">Бесплатный замер</div>
    <p class="conv-micro">Замерщик приедет с образцами материалов и каталогом</p>
    <input type="tel" placeholder="+7 (___) ___-__-__" data-phone />
    <input type="text" name="name" value="" data-honey style="position:absolute;left:-9999px;opacity:0" tabindex="-1" autocomplete="off" />
    <button type="button" data-call>Вызвать замерщика</button>
  </div>
  <nav class="conv-card conv-nav">
    <div class="conv-title">Каталог</div>
      {cats.map((c) => (
        <a href={c.href} class:list={["conv-link", { active: c.id === currentCategory }]}>
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" set:html={c.svg} />
          {c.label}
        </a>
      ))}
    </nav>
  <div class="conv-card conv-trust">
    <div><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="#5A8524" stroke-width="2" aria-hidden="true"><path d="M5 12l5 5 9-11"/></svg>Гарантия по договору</div>
    <div><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="#5A8524" stroke-width="2" aria-hidden="true"><path d="M5 12l5 5 9-11"/></svg>Собственное производство</div>
    <div><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="#5A8524" stroke-width="2" aria-hidden="true"><path d="M5 12l5 5 9-11"/></svg>Монтаж за 1 день</div>
  </div>
</div>
</aside>
<script src="/js/sidebar.js?v=8" defer></script>

# 33navesa — Apache-редиректы (Timeweb; Onreza этот файл игнорирует).
# Источники: public/_redirects (Netlify-формат) + onreza.rules.toml.
# Проверка: curl -s -o /dev/null -w "%{http_code} %{redirect_url}\n" https://33navesa.ru/zabory/

RewriteEngine On

# HTTPS + без www (каноника: https://33navesa.ru)
# ВНИМАНИЕ: блок HTTPS-редиректа убран — за прокси Timeweb %{HTTPS} всегда off,
# правило закольцовывало https->https (диагностировано по access_log 28.09.2026).
# Редирект на HTTPS включать тумблером в панели, и только ПОСЛЕ выпуска сертификата.
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

# Дальше — только если нет такого файла/папки (статика важнее)
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Своя страница 404
ErrorDocument 404 /404.html

# --- Точные 301 (старый WordPress / дубли) ---
Redirect 301 /404/ /
Redirect 301 /dlya-dachi/ /katalog/navesy/navesy-dlya-dachi/
Redirect 301 /kak-zakazat/na-konstrukcii-e/ /kak-zakazat/
Redirect 301 /kontakty/dscn0079/ /kontakty/
Redirect 301 /kozyrki/ /katalog/navesy/navesy-dlya-dachi/
Redirect 301 /navesy/ /katalog/navesy/
Redirect 301 /naves-dlya-avtomobilya/ /katalog/navesy/navesy-dlya-mashin/
Redirect 301 /zabory/ /katalog/zabory/
Redirect 301 /partneram/ /

Redirect 301 /uslugi/montazh-2/ /uslugi/montazh/
Redirect 301 /uslugi/zamena/ /uslugi/zamena-polikarbonata/
Redirect 301 /uslugi/zamershiki/ /uslugi/vyezd-zamershhika/
Redirect 301 /katalog/navesy/navesy-iz-polikarbonata/ /zakazat-naves-iz-polikarbonata/
